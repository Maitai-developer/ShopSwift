rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'gakumicollins@gmail.com';
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 1000 &&
             data.priceCents is int && data.priceCents > 0 && data.priceCents <= 100000000 &&
             data.category in ['Audio', 'Wearables', 'Bags', 'Accessories', 'Home Tech'] &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 50 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500 && data.imageUrl.matches('^https://.*'))) &&
             data.stock is int && data.stock >= 0 && data.stock <= 100000 &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time + duration.value(5, 's') &&
             data.updatedAt is timestamp && data.updatedAt <= request.time + duration.value(5, 's');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time + duration.value(5, 's') &&
             data.updatedAt is timestamp && data.updatedAt <= request.time + duration.value(5, 's');
    }

    function isValidCartItem(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.priceCents is int && data.priceCents > 0 && data.priceCents <= 100000000 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 99 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 50 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500 && data.imageUrl.matches('^https://.*'))) &&
             data.createdAt is timestamp && data.createdAt <= request.time + duration.value(5, 's') &&
             data.updatedAt is timestamp && data.updatedAt <= request.time + duration.value(5, 's');
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100 &&
             data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300 &&
             data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 500 &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 500 &&
             data.subtotalCents is int && data.subtotalCents > 0 && data.subtotalCents <= 1000000000 &&
             data.shippingCents is int && data.shippingCents >= 0 && data.shippingCents <= 10000000 &&
             data.totalCents is int && data.totalCents == data.subtotalCents + data.shippingCents &&
             data.paymentMethod in ['stripe_payment_sheet', 'stripe_sandbox'] &&
             data.paymentReference is string && data.paymentReference.size() >= 3 && data.paymentReference.size() <= 120 &&
             data.status in ['PAID', 'PROCESSING', 'SHIPPED', 'DELIVERED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time + duration.value(5, 's') &&
             data.updatedAt is timestamp && data.updatedAt <= request.time + duration.value(5, 's');
    }

    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (existing().active == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.active == true || isAdmin());
      allow create: if isAdmin() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().keys().hasAll(['title', 'description', 'priceCents', 'category', 'imageKey', 'stock', 'active', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'description', 'priceCents', 'category', 'imageKey', 'imageUrl', 'stock', 'active', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priceCents', 'category', 'imageKey', 'imageUrl', 'stock', 'active', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /cart/{productId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(productId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         isValidCartItem(incoming()) &&
                         incoming().keys().hasAll(['title', 'priceCents', 'quantity', 'category', 'imageKey', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['title', 'priceCents', 'quantity', 'category', 'imageKey', 'imageUrl', 'createdAt', 'updatedAt']) &&
                         exists(/databases/$(database)/documents/products/$(productId));
        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         isValidCartItem(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'priceCents', 'quantity', 'category', 'imageKey', 'imageUrl', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(productId);
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status in ['PAID', 'PROCESSING'] &&
                       isValidOrder(incoming()) &&
                       incoming().keys().hasAll(['userId', 'customerEmail', 'customerName', 'shippingAddress', 'itemsSummary', 'itemCount', 'subtotalCents', 'shippingCents', 'totalCents', 'paymentMethod', 'paymentReference', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerEmail', 'customerName', 'shippingAddress', 'itemsSummary', 'itemCount', 'subtotalCents', 'shippingCents', 'totalCents', 'paymentMethod', 'paymentReference', 'status', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       !(existing().status == 'DELIVERED' && incoming().status != 'DELIVERED') &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(orderId);
    }
  }
}
