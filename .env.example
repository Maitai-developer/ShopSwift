# STRIPE_PUBLISHABLE_KEY: Stripe publishable key (pk_test_... or pk_live_...) for Stripe PaymentSheet.
# Configure this in the Secrets panel in AI Studio.
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# STRIPE_BACKEND_URL: HTTPS base URL of your server endpoint that creates Stripe PaymentIntents
# (never store a Stripe secret key sk_... inside the Android APK).
STRIPE_BACKEND_URL=https://api.example.com/stripe/
